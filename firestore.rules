rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isPoster() {
      return isSignedIn() &&
        (isAdmin() || exists(/databases/$(database)/documents/posters/$(request.auth.uid)));
    }

    // Public profile info. Each user manages their own doc. Email and
    // createdAt are locked after creation; date of birth, if set, locks
    // after its first save too (it's never editable once filled in).
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.createdAt == resource.data.createdAt &&
        (!('dob' in resource.data) || resource.data.dob == null ||
         request.resource.data.dob == resource.data.dob);
      // Members can delete their own profile (account deletion).
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Admin allowlist. Add yourself here manually in the Firebase console
    // after your first sign-up — the app can never write to this collection.
    match /admins/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Partners approved to post. Only an admin can grant this.
    match /posters/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // "Request posting access" requests. A member can create their own;
    // only an admin can approve (update) or clear (delete) one.
    match /posterRequests/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // Friend (connect) requests. Doc id is "{fromUid}_{toUid}". Either
    // side can read or delete (delete = cancel a pending request, or
    // unfriend an accepted one). The recipient can accept/decline a
    // pending request; the original sender can re-send after a decline.
    match /friendRequests/{reqId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isSignedIn() &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid && (
          (resource.data.toUid == request.auth.uid && resource.data.status == 'pending' &&
           (request.resource.data.status == 'accepted' || request.resource.data.status == 'declined')) ||
          (resource.data.fromUid == request.auth.uid && resource.data.status == 'declined' &&
           request.resource.data.status == 'pending')
        );
      allow delete: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // Activity notifications (new message, a like on your post). Only the
    // recipient can ever read their own notifications. Senders can create
    // one for someone else but never for themselves; the recipient can
    // only flip "read" and nothing else about an entry they didn't send.
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid != request.auth.uid;
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid &&
        request.resource.data.toUid == resource.data.toUid &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    // Direct messages. Conversation id is the two participant uids,
    // sorted and joined with "_", so starting a chat with someone
    // always resolves to the same thread. Any signed-in member can
    // message any member — this isn't limited to friends.
    match /conversations/{convId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participants &&
        request.resource.data.participants.size() == 2;
      allow update: if isSignedIn() &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants;

      match /messages/{msgId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants &&
          request.resource.data.fromUid == request.auth.uid;
      }
    }

    // Stories. Any signed-in member can read. Only posters/admins can
    // create. Authors (or admins) can edit or remove their own posts —
    // but editing can never reassign the author or backdate the post.
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isPoster() && request.resource.data.authorUid == request.auth.uid;
      // Either the author/admin editing real content (author and date
      // locked), or any signed-in member bumping only the like/comment
      // counters — nothing else can change on that second path.
      allow update: if isSignedIn() && (
        (
          (resource.data.authorUid == request.auth.uid || isAdmin()) &&
          request.resource.data.authorUid == resource.data.authorUid &&
          request.resource.data.createdAt == resource.data.createdAt
        ) ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'commentCount'])
      );
      allow delete: if isSignedIn() &&
        (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // One like per member per post. The post's own likeCount field is
    // bumped separately (see the posts update rule above).
    match /postLikes/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Comments on a post. Any signed-in member can comment; the author
    // or an admin can remove one.
    match /postComments/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.authorUid == request.auth.uid;
      allow update: if isSignedIn() &&
        resource.data.authorUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 1000;
      allow delete: if isSignedIn() &&
        (resource.data.authorUid == request.auth.uid || isAdmin());
    }
  }
}
