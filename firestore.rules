rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Shared helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }

    // Admins are allow-listed manually in Firestore Console. Client code cannot
    // create or modify admin records.
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isPoster() {
      return isSignedIn() &&
        (isAdmin() || exists(/databases/$(database)/documents/posters/$(request.auth.uid)));
    }

    function okStr(v, maxLen) {
      return v == null || (v is string && v.size() <= maxLen);
    }

    // Accept only this project's Cloudinary asset URLs, or an empty value.
    function okUrl(v) {
      return v == null || v == '' ||
        (v is string && v.size() <= 600 &&
         v.matches('https://res\\.cloudinary\\.com/d98pty0j/.*'));
    }

    function isMediaType(v) {
      return v in ['image', 'video', 'audio', 'document'];
    }

    // When an attachment URL exists it must have a supported media type.
    // Text-only records may omit URL/type/name or set them to null.
    function okAttachment(url, mediaType, name, maxNameLen) {
      return okUrl(url) &&
        (((url == null || url == '') &&
          (mediaType == null || mediaType == '')) ||
         (url is string && url.size() > 0 && isMediaType(mediaType))) &&
        okStr(name, maxNameLen) &&
        ((url != null && url != '') || name == null || name == '');
    }

    function isBlocked(blockerUid, blockedUid) {
      return exists(/databases/$(database)/documents/blocks/$(blockerUid + '_' + blockedUid));
    }

    function isAcceptedFriend(a, b) {
      return (
        exists(/databases/$(database)/documents/friendRequests/$(a + '_' + b)) &&
        get(/databases/$(database)/documents/friendRequests/$(a + '_' + b)).data.status == 'accepted'
      ) || (
        exists(/databases/$(database)/documents/friendRequests/$(b + '_' + a)) &&
        get(/databases/$(database)/documents/friendRequests/$(b + '_' + a)).data.status == 'accepted'
      );
    }

    function validParticipants(convId, participants) {
      return participants is list && participants.size() == 2 &&
        participants[0] is string && participants[1] is string &&
        participants[0].size() > 0 && participants[1].size() > 0 &&
        participants[0] < participants[1] &&
        convId == participants[0] + '_' + participants[1] &&
        request.auth.uid in participants;
    }

    function validConversationId(convId) {
      let p = convId.split('_');
      return p.size() == 2 && p[0] is string && p[1] is string &&
        p[0].size() > 0 && p[1].size() > 0 && p[0] < p[1] &&
        convId == p[0] + '_' + p[1];
    }

    function otherOf(participants, uid) {
      return participants[0] == uid ? participants[1] : participants[0];
    }

    // ---------- Member profiles ----------
    match /users/{uid} {
      // The members directory and profile cards are available only to signed-in members.
      allow read: if isSignedIn();

      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['displayName', 'bio', 'location', 'photoURL', 'createdAt']) &&
        request.resource.data.keys().hasOnly([
          'displayName', 'bio', 'location', 'photoURL', 'coverURL', 'createdAt',
          'interests', 'hideLocation', 'hideStats', 'hidePresence', 'hideFriendList', 'pinnedPostId'
        ]) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 &&
        request.resource.data.displayName.size() <= 100 &&
        request.resource.data.bio is string && request.resource.data.bio.size() <= 300 &&
        request.resource.data.location is string && request.resource.data.location.size() <= 100 &&
        okUrl(request.resource.data.get('photoURL', null)) &&
        okUrl(request.resource.data.get('coverURL', null)) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.get('interests', []) is list &&
        request.resource.data.get('interests', []).size() <= 6 &&
        request.resource.data.get('hideLocation', false) is bool &&
        request.resource.data.get('hideStats', false) is bool &&
        request.resource.data.get('hidePresence', false) is bool &&
        request.resource.data.get('hideFriendList', false) is bool &&
        okStr(request.resource.data.get('pinnedPostId', null), 200);

      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'bio', 'location', 'photoURL', 'coverURL', 'interests',
          'hideLocation', 'hideStats', 'hidePresence', 'hideFriendList',
          'pinnedPostId', 'email', 'dob'
        ]) &&
        request.resource.data.get('displayName', null) is string &&
        request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 100 &&
        okStr(request.resource.data.get('bio', null), 300) &&
        okStr(request.resource.data.get('location', null), 100) &&
        okUrl(request.resource.data.get('photoURL', null)) &&
        okUrl(request.resource.data.get('coverURL', null)) &&
        request.resource.data.get('interests', []) is list &&
        request.resource.data.get('interests', []).size() <= 6 &&
        request.resource.data.get('hideLocation', false) is bool &&
        request.resource.data.get('hideStats', false) is bool &&
        request.resource.data.get('hidePresence', false) is bool &&
        request.resource.data.get('hideFriendList', false) is bool &&
        okStr(request.resource.data.get('pinnedPostId', null), 200) &&
        // The legacy public email can only be removed, never added or changed.
        (request.resource.data.get('email', null) == null ||
         request.resource.data.get('email', null) == resource.data.get('email', null)) &&
        // createdAt is immutable. Legacy DOB can only be removed after migration.
        request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null) &&
        (!('dob' in resource.data) || resource.data.dob == null ||
         !('dob' in request.resource.data) ||
         request.resource.data.dob == resource.data.dob);

      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Date of birth is private and only set by its owner.
    match /userDob/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['dob']) &&
        request.resource.data.dob is string && request.resource.data.dob.size() <= 10;
      // Keep the existing DOB unchanged; only a delete/recreate by the owner can reset it.
      allow update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['dob']) &&
        request.resource.data.get('dob', null) == resource.data.get('dob', null);
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // Hidden location is visible only to the owner and accepted friends.
    match /userLocations/{uid} {
      allow read: if isSignedIn() &&
        (request.auth.uid == uid || isAcceptedFriend(request.auth.uid, uid));
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['location']) &&
        request.resource.data.location is string && request.resource.data.location.size() <= 100;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Blocking ----------
    match /blocks/{blockId} {
      allow read: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['blockerUid', 'blockedUid', 'createdAt']) &&
        request.resource.data.blockerUid == request.auth.uid &&
        request.resource.data.blockedUid is string &&
        request.resource.data.blockedUid.size() > 0 &&
        request.resource.data.blockedUid != request.auth.uid &&
        blockId == request.auth.uid + '_' + request.resource.data.blockedUid &&
        request.resource.data.createdAt == request.time;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
    }

    // ---------- Reports ----------
    // One report per reporter per target; only admins can read/manage reports.
    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'type', 'targetId', 'postId', 'reportedUid', 'reportedName', 'reporterUid',
          'reason', 'details', 'snippet', 'status', 'createdAt'
        ]) &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.targetId is string && request.resource.data.targetId.size() > 0 &&
        reportId == request.auth.uid + '_' + request.resource.data.targetId &&
        request.resource.data.postId is string &&
        request.resource.data.type in ['post', 'comment'] &&
        (
          (request.resource.data.type == 'post' &&
           request.resource.data.targetId == request.resource.data.postId &&
           exists(/databases/$(database)/documents/posts/$(request.resource.data.postId))) ||
          (request.resource.data.type == 'comment' &&
           exists(/databases/$(database)/documents/postComments/$(request.resource.data.targetId)) &&
           get(/databases/$(database)/documents/postComments/$(request.resource.data.targetId)).data.postId == request.resource.data.postId)
        ) &&
        okStr(request.resource.data.get('reportedUid', ''), 128) &&
        request.resource.data.reportedName is string && request.resource.data.reportedName.size() <= 100 &&
        request.resource.data.reason is string && request.resource.data.reason.size() <= 40 &&
        request.resource.data.details is string && request.resource.data.details.size() <= 300 &&
        request.resource.data.snippet is string && request.resource.data.snippet.size() <= 160 &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time;
      allow read, update, delete: if isAdmin();
    }

    // ---------- Online presence ----------
    match /presence/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['lastSeen']) &&
        request.resource.data.lastSeen == request.time;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Saved stories ----------
    match /savedPosts/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'postId', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.postId is string &&
        id == request.auth.uid + '_' + request.resource.data.postId &&
        exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)) &&
        request.resource.data.createdAt == request.time;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Each member manages their own list of accepted friend UIDs.
    match /friendLists/{uid} {
      allow read: if isSignedIn() &&
        (request.auth.uid == uid || isAcceptedFriend(request.auth.uid, uid));
      allow create, update: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['uids']) &&
        request.resource.data.uids is list && request.resource.data.uids.size() <= 500;
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Admin and posting permissions ----------
    match /admins/{uid} {
      // The app only needs to check a member's own admin document.
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /posters/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['approvedAt', 'approvedBy']) &&
        request.resource.data.approvedAt == request.time &&
        request.resource.data.approvedBy == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /posterRequests/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['email', 'displayName', 'status', 'requestedAt']) &&
        okStr(request.resource.data.get('email', null), 254) &&
        request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.requestedAt == request.time;
      // Members may apply again after their previous request is no longer pending.
      allow update: if isSignedIn() && (
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
         request.resource.data.status == 'approved') ||
        (request.auth.uid == uid && resource.data.status != 'pending' &&
         request.resource.data.keys().hasOnly(['email', 'displayName', 'status', 'requestedAt']) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'displayName', 'status', 'requestedAt']) &&
         okStr(request.resource.data.get('email', null), 254) &&
         request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100 &&
         request.resource.data.status == 'pending' && request.resource.data.requestedAt == request.time)
      );
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
    }

    // ---------- Friend requests ----------
    // Document ID is fromUid_toUid. Either participant may read/delete it.
    match /friendRequests/{reqId} {
      allow read: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'fromUid', 'fromName', 'toUid', 'toName', 'status', 'createdAt'
        ]) &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.fromUid is string &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        reqId == request.resource.data.fromUid + '_' + request.resource.data.toUid &&
        request.resource.data.status == 'pending' &&
        okStr(request.resource.data.get('fromName', null), 100) &&
        okStr(request.resource.data.get('toName', null), 100) &&
        request.resource.data.createdAt == request.time &&
        !isBlocked(request.resource.data.toUid, request.auth.uid) &&
        !isBlocked(request.auth.uid, request.resource.data.toUid);

      allow update: if isSignedIn() &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.toUid == resource.data.toUid &&
        reqId == resource.data.fromUid + '_' + resource.data.toUid &&
        request.resource.data.keys().hasOnly([
          'fromUid', 'fromName', 'toUid', 'toName', 'status', 'createdAt', 'respondedAt'
        ]) &&
        (
          // Recipient accepts or declines a pending request.
          (resource.data.toUid == request.auth.uid &&
           resource.data.status == 'pending' &&
           request.resource.data.status in ['accepted', 'declined'] &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']) &&
           request.resource.data.respondedAt == request.time) ||
          // Original sender may resend after a decline (the client rewrites the doc).
          (resource.data.fromUid == request.auth.uid &&
           resource.data.status == 'declined' &&
           request.resource.data.status == 'pending' &&
           request.resource.data.createdAt == request.time &&
           okStr(request.resource.data.get('fromName', null), 100) &&
           okStr(request.resource.data.get('toName', null), 100) &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'respondedAt', 'createdAt', 'fromName', 'toName'
           ]) &&
           !('respondedAt' in request.resource.data))
        );

      allow delete: if isSignedIn() &&
        (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // ---------- Activity notifications ----------
    match /notifications/{id} {
      allow read: if isSignedIn() && resource.data.toUid == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'toUid', 'fromUid', 'fromName', 'type', 'read', 'createdAt',
          'postId', 'postTitle', 'convId'
        ]) &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        !isBlocked(request.resource.data.toUid, request.auth.uid) &&
        !isBlocked(request.auth.uid, request.resource.data.toUid) &&
        request.resource.data.type in ['like', 'comment', 'reply', 'message', 'friendRequest', 'friendAccept'] &&
        request.resource.data.read == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.fromName is string && request.resource.data.fromName.size() <= 100 &&
        (!('postId' in request.resource.data) || okStr(request.resource.data.postId, 200)) &&
        (!('postTitle' in request.resource.data) || okStr(request.resource.data.postTitle, 300)) &&
        (!('convId' in request.resource.data) || okStr(request.resource.data.convId, 300));
      allow update: if isSignedIn() && resource.data.toUid == request.auth.uid &&
        request.resource.data.toUid == resource.data.toUid &&
        request.resource.data.fromUid == resource.data.fromUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']) &&
        request.resource.data.read == true;
      allow delete: if isSignedIn() && resource.data.toUid == request.auth.uid;
    }

    // ---------- Direct conversations and messages ----------
    match /conversations/{convId} {
      allow read: if isSignedIn() &&
        (resource == null || request.auth.uid in resource.data.participants);

      // A conversation is between exactly two sorted participants. The client
      // normally creates it when sending its first message. The small read-state
      // create branches also cover a first-message snapshot race in the client.
      allow create: if isSignedIn() &&
        validParticipants(convId, request.resource.data.get('participants', [])) &&
        request.resource.data.keys().hasOnly([
          'participants', 'lastMessage', 'lastMessageAt', 'lastMessageBy',
          'lastReadAt0', 'lastReadAt1', 'typingAt0', 'typingAt1'
        ]) &&
        (
          (request.resource.data.keys().hasOnly([
             'participants', 'lastMessage', 'lastMessageAt', 'lastMessageBy'
           ]) &&
           request.resource.data.get('lastMessage', null) is string &&
           request.resource.data.lastMessage.size() > 0 &&
           request.resource.data.lastMessage.size() <= 2000 &&
           request.resource.data.get('lastMessageBy', null) == request.auth.uid &&
           request.resource.data.get('lastMessageAt', null) == request.time) ||
          (request.resource.data.keys().hasOnly(['participants', 'lastReadAt0']) &&
           request.resource.data.participants[0] == request.auth.uid &&
           request.resource.data.lastReadAt0 == request.time) ||
          (request.resource.data.keys().hasOnly(['participants', 'lastReadAt1']) &&
           request.resource.data.participants[1] == request.auth.uid &&
           request.resource.data.lastReadAt1 == request.time)
        );

      allow update: if isSignedIn() &&
        resource.data.participants is list &&
        validParticipants(convId, resource.data.participants) &&
        request.auth.uid in resource.data.participants &&
        request.resource.data.participants == resource.data.participants &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'participants', 'lastMessage', 'lastMessageAt', 'lastMessageBy',
          'lastReadAt0', 'lastReadAt1', 'typingAt0', 'typingAt1'
        ]) &&
        (
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'lastMessage', 'lastMessageAt', 'lastMessageBy'
           ])) ||
          (request.resource.data.get('lastMessage', null) is string &&
           request.resource.data.lastMessage.size() <= 2000 &&
           request.resource.data.get('lastMessageBy', null) == request.auth.uid &&
           request.resource.data.get('lastMessageAt', null) == request.time)
        ) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastReadAt0']) ||
         (request.auth.uid == resource.data.participants[0] &&
          request.resource.data.lastReadAt0 == request.time)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastReadAt1']) ||
         (request.auth.uid == resource.data.participants[1] &&
          request.resource.data.lastReadAt1 == request.time)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['typingAt0']) ||
         (request.auth.uid == resource.data.participants[0] &&
          request.resource.data.typingAt0 == request.time)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['typingAt1']) ||
         (request.auth.uid == resource.data.participants[1] &&
          request.resource.data.typingAt1 == request.time));

      match /messages/{msgId} {
        // Messages are authorized by the two sorted UIDs in the conversation ID,
        // so the first message can be written before the parent conversation exists.
        allow read: if isSignedIn() && validConversationId(convId) &&
          request.auth.uid in convId.split('_');

        allow create: if isSignedIn() && validConversationId(convId) &&
          request.auth.uid in convId.split('_') &&
          request.resource.data.keys().hasOnly([
            'fromUid', 'text', 'createdAt', 'attachmentURL', 'attachmentType', 'attachmentName'
          ]) &&
          request.resource.data.fromUid == request.auth.uid &&
          request.resource.data.text is string && request.resource.data.text.size() <= 2000 &&
          request.resource.data.createdAt == request.time &&
          okAttachment(
            request.resource.data.get('attachmentURL', null),
            request.resource.data.get('attachmentType', null),
            request.resource.data.get('attachmentName', null), 180
          ) &&
          (request.resource.data.text.size() > 0 ||
           (request.resource.data.get('attachmentURL', null) is string &&
            request.resource.data.attachmentURL.size() > 0)) &&
          !isBlocked(otherOf(convId.split('_'), request.auth.uid), request.auth.uid) &&
          !isBlocked(request.auth.uid, otherOf(convId.split('_'), request.auth.uid));

        allow delete: if isSignedIn() && validConversationId(convId) &&
          request.auth.uid in convId.split('_') && resource.data.fromUid == request.auth.uid;
      }
    }

    // ---------- Stories ----------
    match /posts/{postId} {
      allow read: if isSignedIn();

      allow create: if isPoster() &&
        request.resource.data.keys().hasOnly([
          'title', 'body', 'attachmentURL', 'attachmentType', 'attachmentName',
          'photoURL', 'authorUid', 'authorName', 'likeCount', 'commentCount', 'createdAt'
        ]) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.body is string && request.resource.data.body.size() <= 10000 &&
        okStr(request.resource.data.get('authorName', null), 100) &&
        okAttachment(
          request.resource.data.get('attachmentURL', null),
          request.resource.data.get('attachmentType', null),
          request.resource.data.get('attachmentName', null), 200
        ) &&
        okUrl(request.resource.data.get('photoURL', null)) &&
        // Latest members.js initializes these legacy display fields to zero.
        // Counts are derived from postLikes/postComments and cannot be updated later.
        request.resource.data.get('likeCount', 0) == 0 &&
        request.resource.data.get('commentCount', 0) == 0 &&
        request.resource.data.createdAt == request.time;

      allow update: if isSignedIn() &&
        (resource.data.authorUid == request.auth.uid || isAdmin()) &&
        request.resource.data.authorUid == resource.data.authorUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'body', 'attachmentURL', 'attachmentType', 'attachmentName',
          'photoURL', 'updatedAt', 'authorName'
        ]) &&
        (request.resource.data.get('title', null) == resource.data.get('title', null) ||
         (request.resource.data.title is string && request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 200)) &&
        (request.resource.data.get('body', null) == resource.data.get('body', null) ||
         (request.resource.data.body is string && request.resource.data.body.size() > 0 &&
          request.resource.data.body.size() <= 10000)) &&
        okAttachment(
          request.resource.data.get('attachmentURL', null),
          request.resource.data.get('attachmentType', null),
          request.resource.data.get('attachmentName', null), 200
        ) &&
        okUrl(request.resource.data.get('photoURL', null)) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['updatedAt']) ||
         request.resource.data.updatedAt == request.time) &&
        (request.resource.data.get('authorName', null) == resource.data.get('authorName', null) ||
         (isAdmin() && request.resource.data.authorName is string &&
          request.resource.data.authorName.size() <= 100));

      allow delete: if isSignedIn() &&
        (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // ---------- Story likes ----------
    // Like document ID is postId_uid, allowing one like per member per story.
    match /postLikes/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly(['postId', 'uid', 'createdAt']) &&
        request.resource.data.postId is string &&
        request.resource.data.uid == request.auth.uid &&
        id == request.resource.data.postId + '_' + request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        exists(/databases/$(database)/documents/posts/$(request.resource.data.postId));
      allow delete: if isSignedIn() &&
        resource.data.uid == request.auth.uid &&
        id == resource.data.postId + '_' + request.auth.uid;
    }

    // ---------- Story comments and voice comments ----------
    match /postComments/{id} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.keys().hasOnly([
          'postId', 'parentId', 'authorUid', 'authorName', 'text', 'createdAt',
          'attachmentURL', 'attachmentType', 'attachmentName'
        ]) &&
        request.resource.data.keys().hasAll(['postId', 'authorUid', 'authorName', 'text', 'createdAt']) &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100 &&
        request.resource.data.postId is string &&
        exists(/databases/$(database)/documents/posts/$(request.resource.data.postId)) &&
        (!('parentId' in request.resource.data) ||
         (request.resource.data.parentId is string &&
          exists(/databases/$(database)/documents/postComments/$(request.resource.data.parentId)) &&
          get(/databases/$(database)/documents/postComments/$(request.resource.data.parentId)).data.postId == request.resource.data.postId)) &&
        request.resource.data.text is string && request.resource.data.text.size() <= 1000 &&
        request.resource.data.createdAt == request.time &&
        (
          (request.resource.data.text.size() > 0 &&
           !('attachmentURL' in request.resource.data) &&
           !('attachmentType' in request.resource.data) &&
           !('attachmentName' in request.resource.data)) ||
          (request.resource.data.get('attachmentURL', null) is string &&
           request.resource.data.attachmentURL.size() > 0 &&
           okUrl(request.resource.data.attachmentURL) &&
           request.resource.data.get('attachmentType', null) == 'audio' &&
           okStr(request.resource.data.get('attachmentName', null), 200)) ||
          (request.resource.data.text.size() > 0 &&
           request.resource.data.get('attachmentURL', null) is string &&
           request.resource.data.attachmentURL.size() > 0 &&
           okUrl(request.resource.data.attachmentURL) &&
           request.resource.data.get('attachmentType', null) == 'audio' &&
           okStr(request.resource.data.get('attachmentName', null), 200))
        );

      allow update: if isSignedIn() && (
        (resource.data.authorUid == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']) &&
         request.resource.data.text is string &&
         request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000 &&
         request.resource.data.editedAt == request.time) ||
        (isAdmin() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorName']) &&
         request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100)
      );

      allow delete: if isSignedIn() &&
        (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    // Anything not explicitly matched above is denied by default.
  }
}
